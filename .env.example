# Kopieer dit bestand naar .env.local (lokaal) of vul deze waarden in bij je hostingpartij (bijv. Vercel).

# Adres van de website, zonder / aan het eind. Lokaal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://afvallenenafblijven.nl

# --- Claude (schema's maken) ---------------------------------------------
# API-sleutel van https://platform.claude.com
ANTHROPIC_API_KEY=
# Optioneel: ander model. Standaard: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Database (PostgreSQL, bij voorkeur in een EU-regio) -------------------
# Bijv. Neon (neon.tech) of Supabase. Tabellen worden automatisch aangemaakt.
DATABASE_URL=postgres://gebruiker:wachtwoord@host:5432/database?sslmode=require

# --- Mollie (betalingen en abonnementen) -----------------------------------
# API-sleutel van je websiteprofiel in Mollie: eerst test_..., voor live live_...
# Een webhook hoef je niet in te stellen; de website stuurt het adres zelf mee.
MOLLIE_API_KEY=test_...
# Alleen voor tests tegen een nagebootste Mollie; nooit in productie.
# MOLLIE_API_BASE=http://127.0.0.1:4343/v2

# --- E-mail (SMTP) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Afvallen & Afblijven <info@afvallenenafblijven.nl>"
# Hier komen meldingen binnen (contactformulier, herroepingen, opzegverzoeken, fouten)
ADMIN_EMAIL=info@afvallenenafblijven.nl

# --- Beheer (/beheer) ---------------------------------------------------------
# Wachtwoord voor de beheeromgeving, minimaal 12 tekens.
ADMIN_PASSWORD=
# Alleen voor een demo met voorbeelddata; nooit op de live site aanzetten.
# BEHEER_DEMO=1

# --- Dagelijkse taak ---------------------------------------------------------
# Willekeurige lange tekst; Vercel stuurt deze automatisch mee naar /api/cron
CRON_SECRET=

# --- Gezondheidsapps koppelen (optioneel) -----------------------------------
# Sleutel om toegangstokens versleuteld op te slaan: 64 hextekens (openssl rand -hex 32)
HEALTH_ENCRYPTION_KEY=
# Withings (weegschalen, Health Mate): app op developer.withings.com,
# callback-URL https://jouwdomein.nl/api/koppelingen/withings/callback
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Testen zonder apparaat (demo-account van Withings)
# WITHINGS_DEMO=1
# Junction (Apple Health, Garmin, Fitbit, Oura, Polar, ...): junction.com, EU-regio.
# Webhook: https://jouwdomein.nl/api/koppelingen/junction/webhook
JUNCTION_API_KEY=
JUNCTION_WEBHOOK_SECRET=
# eu (standaard) of us; production (standaard) of sandbox
# JUNCTION_REGION=eu
# JUNCTION_ENVIRONMENT=sandbox
# Welke cloud-apps de klant kan kiezen (Strava bewust niet: AI-verbod in de API-voorwaarden)
# JUNCTION_PROVIDERS=garmin,fitbit,oura,polar
# Apple Health via de Junction-app met koppelcode (Grow- of Scale-abonnement bij Junction)
# JUNCTION_APPLE_HEALTH=1

# --- Statistieken en advertenties (optioneel, alleen na cookietoestemming) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
